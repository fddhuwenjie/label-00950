# ===================
# 通用忽略文件
# ===================

# 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 编辑器和 IDE
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ===================
# Node.js / 前端项目
# ===================

# 依赖目录
node_modules/
*/node_modules/

# 构建输出
dist/
*/dist/
build/
*/build/

# 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 环境变量
.env
.env.local
.env.*.local
.env.development
.env.production
*/.env
*/.env.local
*/.env.*.local
!.env.example

# 安全日志
backend/logs/
backend/api/logs/

# 缓存目录
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# 测试覆盖率
coverage/
*/coverage/

# ===================
# PHP / WordPress
# ===================

# WordPress 核心文件（通过 Docker 安装）
backend/wp-admin/
backend/wp-includes/
backend/wp-*.php
!backend/wp-config-docker.php
backend/index.php
backend/license.txt
backend/readme.html
backend/xmlrpc.php

# WordPress 上传目录
backend/wp-content/uploads/
uploads/

# WordPress 缓存
backend/wp-content/cache/
backend/wp-content/advanced-cache.php
backend/wp-content/wp-cache-config.php
backend/wp-content/db.php

# 已安装的插件和主题（只保留自定义的）
backend/wp-content/plugins/*
!backend/wp-content/plugins/cross-border-commerce/
backend/wp-content/themes/*
!backend/wp-content/themes/.gitkeep

# Composer
vendor/
composer.lock

# ===================
# Docker
# ===================

# Docker 数据卷
mysql_data/
wordpress_data/

# Docker 构建缓存
.docker/

